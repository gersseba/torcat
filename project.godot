; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Torcat"
run/main_scene="res://scenes/app_root.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://resources/assets/ui/icons/torcat_icon.png"

[autoload]

AppRouter="*res://scripts/autoload/app_router.gd"
AppState="*res://scripts/autoload/app_state.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"

[boot_splash]

image="res://resources/assets/ui/backgrounds/splash.png"
bg_color=Color(0.239216, 0.270588, 0.168627, 1)
fullsize=true

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/torcat_practice/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
