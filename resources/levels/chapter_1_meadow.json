          "direction": "west"
        },
        {
          "type": "say",
          "speaker": "enemy:hill_mouse",
          "text": {
            "en": "Squeak! This hill belongs to the badger! Turn around, shell-head!",
            "de": "Piep! Dieser Hügel gehört dem Dachs! Kehr um, Panzerkopf!"
          }
        },
        {
          "type": "say",
          "speaker": "tortoise",
          "text": {
            "en": "A badger? Hmm. I'm not turning back now.",
            "de": "Ein Dachs? Hm. Umkehren werde ich jetzt nicht."
          }
        },
        {
          "type": "camera_reset",
          "duration": 0.6
