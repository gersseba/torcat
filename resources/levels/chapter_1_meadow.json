      "actions": [
        {
          "type": "camera",
          "zoom": 1.6,
          "duration": 0.8,
          "actor": "enemy:oak_goose"
        },
        {
          "type": "say",
          "speaker": "enemy:oak_goose",
          "text": {
            "en": "Honk! Nobody passes the old oaks without going through me!",
            "de": "Schnatter! An den alten Eichen kommt keiner an mir vorbei!"
          }
        },
        {
          "type": "say",
          "speaker": "tortoise",
          "text": {
            "en": "Six power... I'll need some salad and a few smaller victories first.",
            "de": "Sechs Kraft ... da brauche ich erst Salat und ein paar kleinere Siege."
          }
        },
        {
          "type": "camera_reset",
          "duration": 0.6
        }
      ]
    },
    {
      "id": "hill_mouse_seen",
