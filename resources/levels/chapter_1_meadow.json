  "events": [
    {
      "id": "meadow_start",
      "trigger": {
        "type": "level_start"
      },
      "actions": [
        {
          "type": "say",
          "speaker": "tortoise",
          "text": {
            "en": "What a lovely meadow... but my eggs belong at the very top of the hill.",
            "de": "Was für eine schöne Wiese ... aber meine Eier gehören ganz oben auf den Hügel."
          }
        },
        {
          "type": "message",
          "text": {
            "en": "Tap a spot to preview a path, tap again to walk. Tap while walking to stop. The shallow water is safe. Tap a barrel twice to walk beside it and attack it for food.",
            "de": "Tippe eine Stelle für eine Wegvorschau, erneut zum Laufen. Tippe unterwegs zum Anhalten. Das flache Wasser ist sicher. Tippe ein Fass zweimal an, um daneben zu laufen und es für Futter aufzubrechen."
          }
        }
      ]
    },
    {
      "id": "oak_goose_seen",
      "trigger": {
        "type": "enter_tile",
        "character": "tortoise",
        "area": {
          "x": 3,
          "y": 3,
          "w": 3,
          "h": 3
        }
      },
      "actions": [
        {
          "type": "camera",
          "zoom": 1.6,
          "duration": 0.8,
          "actor": "enemy:oak_goose"
        },
        {
          "type": "say",
          "speaker": "enemy:oak_goose",
          "text": {
            "en": "Honk! Nobody passes this old wall without going through me!",
            "de": "Schnatter! An dieser alten Mauer kommt keiner an mir vorbei!"
          }
        },
        {
          "type": "say",
          "speaker": "tortoise",
          "text": {
            "en": "That goose looks strong... I'll need some salad and a few smaller victories first.",
            "de": "Diese Gans sieht stark aus ... da brauche ich erst Salat und ein paar kleinere Siege."
          }
        },
        {
          "type": "camera_reset",
          "duration": 0.6
        }
      ]
    },
    {
      "id": "hill_mouse_seen",
      "trigger": {
        "type": "enter_tile",
        "character": "tortoise",
        "area": {
          "x": 11,
          "y": 2,
          "w": 4,
          "h": 5
        }
      },
      "actions": [
        {
          "type": "camera",
          "zoom": 1.6,
          "duration": 0.8,
          "actor": "enemy:hill_mouse"
        },
        {
          "type": "face",
          "actor": "enemy:hill_mouse",
          "direction": "west"
        },
        {
          "type": "say",
          "speaker": "enemy:hill_mouse",
          "text": {
            "en": "Squeak! This hill belongs to the badger! Turn around, shell-head!",
            "de": "Piep! Dieser Hügel gehört dem Dachs! Kehr um, Panzerkopf!"
          }
        },
        {
          "type": "say",
          "speaker": "tortoise",
          "text": {
            "en": "A badger? Hmm. I'm not turning back now.",
            "de": "Ein Dachs? Hm. Umkehren werde ich jetzt nicht."
          }
        },
        {
          "type": "camera_reset",
          "duration": 0.6
        }
      ]
    },
    {
      "id": "meadow_victory",
      "trigger": {
        "type": "victory"
      },
      "actions": [
        {
          "type": "say",
          "speaker": "tortoise",
          "text": {
            "en": "The first slope! Onward, up the hill.",
            "de": "Der erste Hang! Weiter, den Hügel hinauf."
          }
        }
      ]
    }
