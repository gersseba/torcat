  "events": [
    {
      "id": "foothills_start",
      "trigger": {
        "type": "level_start"
      },
      "actions": [
        {
          "type": "say",
          "speaker": "tortoise",
          "text": {
            "en": "It's dark under these trees. Moss cushions my steps... perhaps those hollow stumps hide some food.",
            "de": "Unter diesen Bäumen ist es dunkel. Das Moos polstert meine Schritte ... vielleicht steckt Futter in den hohlen Stümpfen."
          }
        },
        {
          "type": "camera",
          "zoom": 1.5,
          "duration": 0.8,
          "actor": "enemy:foothill_snake"
        },
        {
          "type": "say",
          "speaker": "enemy:foothill_snake",
          "text": {
            "en": "Sssso slow... and sssso weak. You'll never be strong enough to pass me.",
            "de": "Ssso langsam ... und ssso schwach. Du wirst nie stark genug sein, um an mir vorbeizukommen."
          }
        },
        {
          "type": "camera_reset",
          "duration": 0.6
        }
      ]
    },
    {
      "id": "first_shell_found",
      "trigger": {
        "type": "enter_tile",
        "character": "tortoise",
        "position": {
          "x": 1,
          "y": 1
        }
      },
      "actions": [
        {
          "type": "say",
          "speaker": "tortoise",
          "text": {
            "en": "A shell charm! It hardens my shell. I'll save it for someone I can't beat otherwise.",
            "de": "Ein Panzer-Amulett! Es härtet meinen Panzer. Ich hebe es für jemanden auf, den ich sonst nicht schaffe."
          }
        },
        {
          "type": "message",
          "text": {
            "en": "Toggle Shell on to strengthen your attacks. Golden sparks show it's ready. Toggle it off to save your reserve for tough foes.",
            "de": "Schalte den Panzer ein, um deine Angriffe zu verstärken. Goldene Funken zeigen, dass er bereit ist. Schalte ihn aus, um deine Reserve für starke Gegner zu sparen."
          }
        }
      ]
    },
    {
      "id": "ridge_mouse_seen",
      "trigger": {
        "type": "enter_tile",
        "character": "tortoise",
        "area": {
          "x": 10,
          "y": 3,
          "w": 3,
          "h": 3
        }
      },
      "actions": [
        {
          "type": "camera",
          "zoom": 1.6,
          "duration": 0.8,
          "actor": "enemy:ridge_mouse"
        },
        {
          "type": "say",
          "speaker": "enemy:ridge_mouse",
          "text": {
            "en": "The badger promised us mice this whole hill. Scram!",
            "de": "Der Dachs hat uns Mäusen den ganzen Hügel versprochen. Verschwinde!"
          }
        },
        {
          "type": "say",
          "speaker": "tortoise",
          "text": {
            "en": "Mice. Why is it always mice...",
            "de": "Mäuse. Warum immer Mäuse ..."
          }
        },
        {
          "type": "camera_reset",
          "duration": 0.6
        }
      ]
    },
    {
      "id": "foothills_victory",
      "trigger": {
        "type": "victory"
      },
      "actions": [
        {
          "type": "say",
          "speaker": "tortoise",
          "text": {
            "en": "Phew. They keep getting stronger the higher I climb.",
            "de": "Puh. Je höher ich klettere, desto stärker werden sie."
          }
        }
      ]
    }
  ]
