  "events": [
    {
      "id": "cat_trapped",
      "trigger": {
        "type": "level_start"
      },
      "actions": [
        {
          "type": "camera",
          "zoom": 1.7,
          "duration": 1.0,
          "actor": "cat"
        },
        {
          "type": "say",
          "speaker": "cat",
          "text": {
            "en": "H-help! Spiky things everywhere! I can't get past their quills!",
            "de": "H-hilfe! Überall stachelige Dinger! Ich komme nicht an ihren Stacheln vorbei!"
          }
        },
        {
          "type": "animate",
          "actor": "enemy:ring_east",
          "animation": "flinch"
        },
        {
          "type": "say",
          "speaker": "tortoise",
          "text": {
            "en": "Hold on! My shell doesn't mind a few spikes.",
            "de": "Halt durch! Meinem Panzer machen ein paar Stacheln nichts aus."
          }
        },
        {
          "type": "message",
          "text": {
            "en": "Defeat the hedgehogs around the cat. Start with the weakest.",
            "de": "Besiege die Igel rund um die Katze. Fang mit dem schwächsten an."
          }
        },
        {
          "type": "camera_reset",
          "duration": 0.6
        }
      ]
    },
    {
      "id": "cat_rescued",
      "trigger": {
        "type": "enemy_defeated",
        "enemies": [
          "ring_west",
          "ring_north",
          "ring_south",
          "ring_east"
        ]
      },
      "actions": [
        {
          "type": "camera",
          "zoom": 1.7,
          "duration": 0.7,
          "actor": "cat"
        },
        {
          "type": "join_party",
          "character": "cat"
        },
        {
          "type": "say",
          "speaker": "cat",
          "text": {
            "en": "You saved me! I'm not good with spikes... but I can Pounce!",
            "de": "Du hast mich gerettet! Mit Stacheln kann ich nicht ... aber ich kann springen!"
          }
        },
        {
          "type": "say",
          "speaker": "cat",
          "text": {
            "en": "I leap up to two tiles and knock the strength out of anyone—even across ledges.",
            "de": "Ich springe bis zu zwei Felder weit und schwäche jeden – sogar über Felskanten."
          }
        },
        {
          "type": "say",
          "speaker": "tortoise",
          "text": {
            "en": "There are mice ahead. Big ones. I really can't stand mice.",
            "de": "Da vorne sind Mäuse. Große. Ich kann Mäuse wirklich nicht ausstehen."
          }
        },
        {
          "type": "message",
          "text": {
            "en": "Tap the cat to select it. Pounce lowers an enemy's power by the cat's power, but earns no reward.",
            "de": "Tippe die Katze an, um sie zu wählen. Ein Sprung senkt die Kraft des Gegners um die Kraft der Katze, bringt aber keine Belohnung."
          }
        },
        {
          "type": "camera_reset",
          "duration": 0.6
        }
      ]
    },
    {
      "id": "ledge_shell_seen",
      "trigger": {
        "type": "enter_tile",
        "character": "any",
        "area": {
          "x": 11,
          "y": 1,
          "w": 8,
          "h": 3
        }
      },
      "actions": [
        {
          "type": "camera",
          "zoom": 1.6,
          "duration": 0.8,
          "position": {
            "x": 15,
            "y": 0
          }
        },
        {
          "type": "say",
          "speaker": "tortoise",
          "text": {
            "en": "A shell charm up on that ledge... no way I can get up there.",
            "de": "Ein Panzer-Amulett da oben auf dem Felsvorsprung ... da komme ich nie hinauf."
          }
        },
        {
          "type": "say",
          "speaker": "cat",
          "text": {
            "en": "Hmm. Not yet, anyway.",
            "de": "Hm. Jedenfalls noch nicht."
          }
        },
        {
          "type": "camera_reset",
          "duration": 0.6
        }
      ]
    },
    {
      "id": "pass_victory",
      "trigger": {
        "type": "victory"
      },
      "actions": [
        {
          "type": "say",
          "speaker": "cat",
          "text": {
            "en": "That was fun! Where are you headed, anyway?",
            "de": "Das hat Spaß gemacht! Wo willst du eigentlich hin?"
          }
        },
        {
          "type": "say",
          "speaker": "tortoise",
          "text": {
            "en": "To the very top of the hill.",
            "de": "Ganz nach oben auf den Hügel."
          }
        }
      ]
    }
  ]
