  "events": [
    {
      "id": "cliffs_start",
      "trigger": {
        "type": "level_start"
      },
      "actions": [
        {
          "type": "camera",
          "zoom": 1.4,
          "duration": 1.0,
          "position": {
            "x": 3,
            "y": 0
          }
        },
        {
          "type": "say",
          "speaker": "cat",
          "text": {
            "en": "Look—shell charms up on those ledges! I can climb, one step at a time.",
            "de": "Schau – Panzer-Amulette auf den Felsvorsprüngen! Ich kann klettern, Stufe für Stufe."
          }
        },
        {
          "type": "say",
          "speaker": "tortoise",
          "text": {
            "en": "I'm not exactly built for climbing...",
            "de": "Ich bin nicht gerade zum Klettern gebaut ..."
          }
        },
        {
          "type": "say",
          "speaker": "cat",
          "text": {
            "en": "Then I'll fetch them for you. Partners, remember?",
            "de": "Dann hole ich sie dir. Partner, schon vergessen?"
          }
        },
        {
          "type": "message",
          "text": {
            "en": "The cat climbs one height level at a time. Shell charms it collects are delivered when it stands next to the tortoise.",
            "de": "Die Katze klettert jeweils eine Höhenstufe. Gesammelte Panzer-Amulette übergibt sie, sobald sie neben der Schildkröte steht."
          }
        },
        {
          "type": "camera_reset",
          "duration": 0.6
        }
      ]
    },
    {
      "id": "stair_snake_seen",
      "trigger": {
        "type": "enter_tile",
        "character": "tortoise",
        "area": {
          "x": 7,
          "y": 5,
          "w": 3,
          "h": 3
        }
      },
      "actions": [
        {
          "type": "camera",
          "zoom": 1.6,
          "duration": 0.8,
          "actor": "enemy:stair_snake"
        },
        {
          "type": "say",
          "speaker": "enemy:stair_snake",
          "text": {
            "en": "Twenty-eight power, little ssshell. Bring your whole family.",
            "de": "Achtundzwanzig Kraft, kleiner Panzer. Bring ruhig deine ganze Familie mit."
          }
        },
        {
          "type": "camera_reset",
          "duration": 0.6
        }
      ]
    },
    {
      "id": "crag_hedgehog_seen",
      "trigger": {
        "type": "enter_tile",
        "character": "cat",
        "area": {
          "x": 11,
          "y": 2,
          "w": 5,
          "h": 3
        }
      },
      "actions": [
        {
          "type": "camera",
          "zoom": 1.6,
          "duration": 0.8,
          "actor": "enemy:crag_hedgehog"
        },
        {
          "type": "say",
          "speaker": "cat",
          "text": {
            "en": "Those quills again... I can't beat it alone. A pounce first, then I'll finish it off!",
            "de": "Schon wieder Stacheln ... allein schaffe ich den nicht. Erst ein Sprung, dann erledige ich ihn!"
          }
        },
        {
          "type": "camera_reset",
          "duration": 0.6
        }
      ]
    },
    {
      "id": "champion_seen",
      "trigger": {
        "type": "enter_tile",
        "character": "tortoise",
        "area": {
          "x": 14,
          "y": 4,
          "w": 3,
          "h": 5
        }
      },
      "actions": [
        {
          "type": "camera",
          "zoom": 1.6,
          "duration": 0.8,
          "actor": "enemy:mouse_champion"
        },
        {
          "type": "say",
          "speaker": "enemy:mouse_champion",
          "text": {
            "en": "I am the champion of all mice! The badger himself gave me this sword!",
            "de": "Ich bin der Champion aller Mäuse! Der Dachs persönlich gab mir dieses Schwert!"
          }
        },
        {
          "type": "say",
          "speaker": "cat",
          "text": {
            "en": "Pounce first, shell second?",
            "de": "Erst springen, dann Panzer?"
          }
        },
        {
          "type": "camera_reset",
          "duration": 0.6
        }
      ]
    },
    {
      "id": "cliffs_victory",
      "trigger": {
        "type": "victory"
      },
      "actions": [
        {
          "type": "say",
          "speaker": "tortoise",
          "text": {
            "en": "Thank you, friend. The summit is right above us.",
            "de": "Danke, Freundin. Der Gipfel liegt direkt über uns."
          }
        }
      ]
    }
  ]
