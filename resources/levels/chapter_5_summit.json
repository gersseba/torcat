  "events": [
    {
      "id": "summit_start",
      "trigger": {
        "type": "level_start"
      },
      "actions": [
        {
          "type": "camera",
          "zoom": 1.5,
          "duration": 1.2,
          "actor": "enemy:badger"
        },
        {
          "type": "face",
          "actor": "enemy:badger",
          "direction": "west"
        },
        {
          "type": "say",
          "speaker": "enemy:badger",
          "text": {
            "en": "So. The slow one and the stray. This hill is MINE—every last blade of grass!",
            "de": "So. Die Langsame und die Streunerin. Dieser Hügel gehört MIR – jeder einzelne Grashalm!"
          }
        },
        {
          "type": "shake",
          "strength": 12,
          "duration": 0.5
        },
        {
          "type": "say",
          "speaker": "tortoise",
          "text": {
            "en": "I only need one little spot at the very top.",
            "de": "Ich brauche nur ein kleines Plätzchen ganz oben."
          }
        },
        {
          "type": "say",
          "speaker": "enemy:badger",
          "text": {
            "en": "NO!",
            "de": "NEIN!"
          }
        },
        {
          "type": "camera_reset",
          "duration": 0.6
        },
        {
          "type": "say",
          "speaker": "cat",
          "text": {
            "en": "Everything we've learned, together. Let's go!",
            "de": "Alles, was wir gelernt haben – gemeinsam. Los geht's!"
          }
        }
      ]
    },
    {
      "id": "badger_approach",
      "trigger": {
        "type": "enter_tile",
        "character": "any",
        "area": {
          "x": 15,
          "y": 3,
          "w": 3,
          "h": 3
        }
      },
      "actions": [
        {
          "type": "camera",
          "zoom": 1.7,
          "duration": 0.8,
          "actor": "enemy:badger"
        },
        {
          "type": "say",
          "speaker": "enemy:badger",
          "text": {
            "en": "Come closer, if you dare! Nobody has ever beaten me!",
            "de": "Kommt nur näher, wenn ihr euch traut! Mich hat noch niemand besiegt!"
          }
        },
        {
          "type": "say",
          "speaker": "cat",
          "text": {
            "en": "There's a first time for everything.",
            "de": "Für alles gibt es ein erstes Mal."
          }
        },
        {
          "type": "camera_reset",
          "duration": 0.6
        }
      ]
    },
    {
      "id": "summit_victory",
      "trigger": {
        "type": "victory"
      },
      "actions": [
        {
          "type": "say",
          "speaker": "tortoise",
          "text": {
            "en": "We did it... the top of the hill.",
            "de": "Wir haben es geschafft ... der Gipfel."
          }
        },
        {
          "type": "say",
          "speaker": "cat",
          "text": {
            "en": "And the badger ran off squealing!",
            "de": "Und der Dachs ist quiekend davongelaufen!"
          }
        }
      ]
    }
  ]
