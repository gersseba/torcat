  "events": [
    {
      "id": "descent_intro",
      "trigger": { "type": "level_start" },
      "actions": [
        { "type": "camera", "actor": "enemy:Boss", "zoom": 1.4, "duration": 1.4 },
        { "type": "say", "speaker": "enemy:Boss", "text": { "en": "Ssssixteen coils of power. Come down, little sssnacks.", "de": "Sssechzehn Windungen voller Kraft. Kommt herab, kleine Hapssse." } },
        { "type": "camera", "actor": "cat", "zoom": 1.5, "duration": 1.2 },
        { "type": "say", "speaker": "cat", "text": { "en": "Sixteen?! We're going to need every trick we have.", "de": "Sechzehn?! Da brauchen wir jeden Trick, den wir kennen." } },
        { "type": "camera_reset", "duration": 0.6 }
      ]
    },
    {
      "id": "hedgehog_defeated",
      "trigger": { "type": "enemy_defeated", "enemy": "Enemy-8-6" },
      "actions": [
        { "type": "say", "speaker": "cat", "text": { "en": "Ow, ow, ow. Who covers themselves in spikes?", "de": "Au, au, au. Wer bedeckt sich denn bitte mit Stacheln?" } }
      ]
    },
    {
      "id": "snake_reveal",
      "trigger": { "type": "enter_tile", "area": { "x": 7, "y": 8, "w": 5, "h": 4 } },
      "actions": [
        { "type": "camera", "actor": "enemy:Boss", "zoom": 1.6, "duration": 0.8 },
        { "type": "face", "actor": "enemy:Boss", "direction": "west" },
        { "type": "shake", "strength": 10, "duration": 0.4 },
        { "type": "say", "speaker": "enemy:Boss", "text": { "en": "Closer... closer... my club hassss been waiting.", "de": "Näher ... näher ... meine Keule hat ssschon gewartet." } },
        { "type": "say", "speaker": "tortoise", "text": { "en": "Too strong to face head-on. Wear it down with Pounces, then finish it with the shell.", "de": "Zu stark für einen Frontalangriff. Mit Sprüngen schwächen, dann mit dem Panzer erledigen." } }
      ]
    },
    {
      "id": "descent_victory",
      "trigger": { "type": "victory" },
      "actions": [
        { "type": "wait", "duration": 0.4 },
        { "type": "say", "speaker": "cat", "text": { "en": "The gorge is ours! Next time, I pick the path.", "de": "Die Schlucht gehört uns! Nächstes Mal suche ich den Weg aus." } },
        { "type": "say", "speaker": "tortoise", "text": { "en": "Next time, we take the stairs slowly.", "de": "Nächstes Mal nehmen wir die Treppe langsam." } }
      ]
    }
  ],
